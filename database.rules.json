{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        "name": {
          ".write": "$uid === auth.uid",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "email": {
          ".write": "$uid === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "createdAt": {
          ".write": "$uid === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "familyId": {
          ".write": "$uid === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "families": {
          ".write": "$uid === auth.uid",
          "$fid": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "role": { ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'member')" }
          }
        },
        "familyAuditLog": {
          ".indexOn": ["ts"],
          "$entryId": {
            ".write": "$uid === auth.uid && !data.exists() && newData.exists() && newData.child('actorUid').val() === auth.uid && newData.child('ts').val() === now",
            ".validate": "newData.hasChildren(['action','actorUid','ts'])",
            "action":     { ".validate": "newData.isString() && newData.val() === 'delete-family'" },
            "actorUid":   { ".validate": "newData.isString() && newData.val().length <= 128" },
            "actorName":  { ".validate": "newData.isString() && newData.val().length <= 80" },
            "ts":         { ".validate": "newData.isNumber() && newData.val() === now" },
            "targetId":   { ".validate": "newData.isString() && newData.val().length <= 128" },
            "targetName": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "meta":       { ".validate": "newData.isString() && newData.val().length <= 500" },
            "$other":     { ".validate": false }
          }
        }
      }
    },
    "families": {
      "$familyId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && ((newData.exists() && !data.exists() && newData.child('members').child(auth.uid).child('role').val() === 'admin') || (data.exists() && !newData.exists() && data.child('members').child(auth.uid).child('role').val() === 'admin'))",
        "name": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "code": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 24"
        },
        "createdBy": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "createdAt": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber()"
        },
        "members": {
          "$memberId": {
            ".write": "auth != null && (data.parent().parent().child('members').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $memberId && !data.exists() && newData.child('joinCode').isString() && root.child('familyCodes').child(newData.child('joinCode').val()).val() === $familyId) || (auth.uid === $memberId && data.exists() && !newData.exists()))",
            "role": {
              ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'member') && (data.parent().parent().parent().child('members').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $memberId && !data.exists()))"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            },
            "joinCode": {
              ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 24"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "pantry": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          "$itemId": {
            "name":     { ".validate": "newData.isString() && newData.val().length <= 80" },
            "emoji":    { ".validate": "newData.isString() && newData.val().length <= 8" },
            "unit":     { ".validate": "newData.isString() && newData.val().length <= 24" },
            "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "status":   { ".validate": "newData.isString() && newData.val().length <= 16" },
            "amount":   { ".validate": "newData.isNumber() || newData.isString()" }
          }
        },
        "staples": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          "$itemId": {
            "name":     { ".validate": "newData.isString() && newData.val().length <= 80" },
            "emoji":    { ".validate": "newData.isString() && newData.val().length <= 8" },
            "unit":     { ".validate": "newData.isString() && newData.val().length <= 24" },
            "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "amount":   { ".validate": "newData.isNumber() || newData.isString()" }
          }
        },
        "recipes": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          "$itemId": {
            "name":        { ".validate": "newData.isString() && newData.val().length <= 100" },
            "emoji":       { ".validate": "newData.isString() && newData.val().length <= 8" },
            "category":    { ".validate": "newData.isString() && newData.val().length <= 40" },
            "difficulty":  { ".validate": "newData.isString() && newData.val().length <= 40" },
            "description": { ".validate": "newData.isString() && newData.val().length <= 2000" }
          }
        },
        "shoppingList": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()",
          "$key": {
            "name":     { ".validate": "newData.isString() && newData.val().length <= 80" },
            "unit":     { ".validate": "newData.isString() && newData.val().length <= 24" },
            "category": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "from":     { ".validate": "newData.isString() && newData.val().length <= 80" }
          }
        },
        "weekPlan": {
          ".write": "auth != null && data.parent().child('members').child(auth.uid).exists()"
        },
        "auditLog": {
          ".indexOn": ["ts"],
          "$entryId": {
            ".write": "auth != null && data.parent().parent().child('members').child(auth.uid).exists() && !data.exists() && newData.exists() && newData.child('actorUid').val() === auth.uid && newData.child('ts').val() === now",
            ".validate": "newData.hasChildren(['action','actorUid','ts'])",
            "action":     { ".validate": "newData.isString() && (newData.val() === 'leave-family' || newData.val() === 'rotate-code' || newData.val() === 'delete-recipe')" },
            "actorUid":   { ".validate": "newData.isString() && newData.val().length <= 128" },
            "actorName":  { ".validate": "newData.isString() && newData.val().length <= 80" },
            "ts":         { ".validate": "newData.isNumber() && newData.val() === now" },
            "targetId":   { ".validate": "newData.isString() && newData.val().length <= 128" },
            "targetName": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "meta":       { ".validate": "newData.isString() && newData.val().length <= 500" },
            "$other":     { ".validate": false }
          }
        }
      }
    },
    "familyCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && !data.exists() && newData.isString() && root.child('families').child(newData.val()).child('members').child(auth.uid).child('role').val() === 'admin') || (!newData.exists() && data.exists() && root.child('families').child(data.val()).child('members').child(auth.uid).child('role').val() === 'admin'))"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && (auth.uid === 'ZntXAQlTABT5zKTsMHs9nwHVdpl1' || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.isBoolean()"
      }
    },
    "feedback": {
      ".indexOn": ["ts","status"],
      ".read": "auth != null && (auth.uid === 'ZntXAQlTABT5zKTsMHs9nwHVdpl1' || root.child('admins').child(auth.uid).val() === true)",
      "$entryId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('userUid').val() === auth.uid && newData.child('ts').val() === now && newData.child('status').val() === 'new') || (auth.uid === 'ZntXAQlTABT5zKTsMHs9nwHVdpl1' || root.child('admins').child(auth.uid).val() === true))",
        ".validate": "newData.hasChildren(['type','message','userUid','ts','status'])",
        "type":      { ".validate": "newData.isString() && (newData.val() === 'bug' || newData.val() === 'wish' || newData.val() === 'other')" },
        "message":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000" },
        "userUid":   { ".validate": "newData.isString() && newData.val().length <= 128" },
        "userEmail": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "ts":        { ".validate": "newData.isNumber()" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'new' || newData.val() === 'read' || newData.val() === 'done')" },
        "version":   { ".validate": "newData.isString() && newData.val().length <= 20" },
        "page":      { ".validate": "newData.isString() && newData.val().length <= 80" },
        "ua":        { ".validate": "newData.isString() && newData.val().length <= 300" },
        "$other":    { ".validate": false }
      }
    }
  }
}
